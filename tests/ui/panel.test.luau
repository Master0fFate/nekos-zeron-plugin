local function configure(app, patch)
 local values=table.clone(app:state("settings"))
 for key,value in patch do values[key]=value end
 app:set_state("settings",values)
 app:frames(2)
end
local function opened()
 local app=mount()
 app:click('role:button "Open image panel"')
 expect(app:wait('~"count=2"')).to_be(true)
 return app
end
local function panel(app,label) app:click('#nekos-native-image >> role:button "'..label..'"') end

test("panel toolbar refresh fetches new records and navigation changes selection",function()
 local app=opened()
 panel(app,"Next"); expect(app:has('~"index=2"')).to_be(true)
 panel(app,"Previous"); expect(app:has('~"index=1"')).to_be(true)
 panel(app,"Refresh")
 expect(app:wait('~"requests=2"')).to_be(true)
 expect(app:wait('~"Loading image 1"')).to_be(true)
 app:frames(5)
 expect(app:state("nekos-panel-1")[1].id).to_be("11")
 panel(app,"Settings"); expect(app:has('"settings"')).to_be(true)
end)

test("slideshow persists, loops through cached images, and pauses while hidden",function()
 local app=opened()
 app:command("fast"); app:command("loaded")
 panel(app,"Play or pause slideshow")
 app:frames(70); expect(app:has('~"index=2"')).to_be(true)
 app:command("loaded"); app:frames(70)
 expect(app:has('~"index=1"')).to_be(true)
 app:frames(70); expect(app:has('~"index=2"')).to_be(true)
 app:command("hide"); app:frames(150)
 expect(app:has('~"index=2"')).to_be(true)
 local reopened=mount()
 expect(reopened:has('~"playing=true; seconds=1"')).to_be(true)
 configure(reopened,{floating_autoplay=true})
 reopened:command("defaults")
 expect(reopened:has('~"playing=false; seconds=20"')).to_be(true)
end)

test("stalled image load times out and playback recovers",function()
 local app=opened()
 app:command("fast"); app:command("loaded")
 panel(app,"Play or pause slideshow")
 app:frames(70)
 expect(app:has('~"index=2"')).to_be(true)
 app:frames(910)
 expect(app:state("image_results")["https://cdn.nekosapi.com/2.webp"]).to_be("failed")
 app:frames(65)
 expect(app:has('~"playing=true"')).to_be(true)
 expect(app:has('~"index=1"')).to_be(true)
end)

test("gallery and single mode share records and selection without another fetch",function()
 local app=opened()
 configure(app,{mode="gallery"})
 expect(app:has('#nekos-native-image >> #nekos-image-list')).to_be(true)
 expect(app:has('#nekos-native-image >> #nekos-image-surface')).to_be(false)
 app:click('role:button "Select image 2"')
 configure(app,{mode="single"})
 expect(app:has('#nekos-native-image >> #nekos-image-surface')).to_be(true)
 expect(app:has('~"index=2"')).to_be(true)
 expect(app:has('~"requests=1"')).to_be(true)
 configure(app,{metadata=false})
 expect(app:has('#nekos-panel-metadata')).to_be(false)
 configure(app,{metadata=true})
 expect(app:has('#nekos-panel-metadata')).to_be(true)
end)

test("each rating and the NSFW master switch apply immediately",function()
 local app=opened()
 for _,rating in {"suggestive","borderline","explicit"} do
  configure(app,{safe=false,enable_nsfw=true,suggestive=rating=="suggestive",borderline=rating=="borderline",explicit=rating=="explicit"})
  expect(app:wait('~"count=1"')).to_be(true)
  expect(app:state("nekos-panel-1")[1].rating).to_be(rating)
  expect(app:has('#nekos-current-image')).to_be(false)
 end
 panel(app,"Reveal")
 expect(app:has('#nekos-current-image')).to_be(true)
 configure(app,{enable_nsfw=false})
 expect(app:wait('~"count=0"')).to_be(true)
 expect(app:has('#nekos-current-image')).to_be(false)
end)

test("hide and blur settings change the gallery immediately",function()
 local app=opened()
 configure(app,{mode="gallery",safe=false,enable_nsfw=true,suggestive=true,hide_nsfw=true,blur_nsfw=true})
 expect(app:wait('~"count=1"')).to_be(true)
 expect(app:has('"NSFW preview hidden"')).to_be(true)
 configure(app,{hide_nsfw=false})
 expect(app:has('#nekos-preview-blur')).to_be(true)
 configure(app,{blur_nsfw=false})
 expect(app:has('#nekos-preview-plain')).to_be(true)
 configure(app,{hide_nsfw=true})
 expect(app:has('#nekos-preview-plain')).to_be(false)
end)

test("tag artist limit and duplicate settings reach requests and local filtering",function()
 local app=opened()
 configure(app,{included_tags="cat ears, sky",artist="A & B",limit=1})
 expect(app:wait('~"count=1"')).to_be(true)
 local url=app:state("last_url")
 expect(string.find(url,"limit=1&rating=safe&tags=cat%%20ears%%2Csky&artist=A%%20%%26%%20B")~=nil).to_be(true)
 configure(app,{excluded_tags="sky"})
 expect(app:wait('~"count=0"')).to_be(true)
 configure(app,{excluded_tags="",limit=12,deduplicate=true})
 expect(app:wait('~"count=2"')).to_be(true)
 app:command("duplicate"); expect(app:wait('~"count=4"')).to_be(true)
 app:command("duplicate"); app:frames(20)
 expect(app:has('~"count=4"')).to_be(true)
 configure(app,{deduplicate=false})
 expect(app:wait('~"count=2"')).to_be(true)
 app:command("duplicate"); expect(app:wait('~"count=4"')).to_be(true)
end)

test("auto refresh interval updates and stops when switched off",function()
 local app=opened()
 configure(app,{auto_refresh=true,refresh_interval=5})
 app:frames(320)
 expect(app:wait('~"requests=2"')).to_be(true)
 configure(app,{auto_refresh=false})
 app:frames(650)
 expect(app:has('~"requests=2"')).to_be(true)
end)

test("auto load more starts when enabled at the end of the grid",function()
 local app=opened()
 configure(app,{mode="gallery",auto_more=false,limit=1})
 expect(app:wait('~"count=1"')).to_be(true)
 local count=app:state("requests")
 configure(app,{auto_more=true})
 expect(app:wait('~"count=2"')).to_be(true)
 expect(app:state("requests")>count).to_be(true)
 configure(app,{auto_more=false})
end)

test("download format selection reaches exporter and settings persist",function()
 local app=opened()
 for _,format in {"original","png","jpeg"} do
  configure(app,{download_format=format})
  app:click('#nekos-panel-controls >> role:button "Download"')
  expect(app:has('"export='..format..'"')).to_be(true)
 end
 configure(app,{mode="gallery",metadata=false,aspect=false,limit=7})
 local reopened=mount()
 expect(reopened:state("settings").mode).to_be("gallery")
 expect(reopened:state("settings").metadata).to_be(false)
 expect(reopened:state("settings").aspect).to_be(false)
 expect(reopened:state("settings").limit).to_be(7)
end)

test("rate limit blocks toolbar refresh during cooldown",function()
 local app=opened()
 app:command("limited")
 expect(app:wait('~"Nekos API rate limit"')).to_be(true)
 panel(app,"Refresh"); app:frames(120)
 expect(app:has('~"requests=2"')).to_be(true)
end)

test("one-image batch fetches another image when slideshow advances",function()
 local app=opened()
 configure(app,{limit=1})
 expect(app:wait('~"count=1"')).to_be(true)
 app:command("fast"); app:command("loaded")
 panel(app,"Play or pause slideshow")
 app:frames(70)
 expect(app:wait('~"selected=21"')).to_be(true)
 expect(app:state("nekos-panel-1")[1].id).to_be("21")
end)

test("API timeout and empty results report status without losing the loaded batch",function()
 local app=opened()
 app:command("timeout"); app:frames(910)
 expect(app:has('~"request timed out"')).to_be(true)
 expect(app:state("nekos-panel-4")).to_be(false)
 app:command("empty")
 expect(app:wait('~"No new images matched"')).to_be(true)
 expect(app:has('~"count=2"')).to_be(true)
end)
