test("native panel is image only and opens without running a process",function()
 local app=mount()
 expect(app:has('~"requests=0"')).to_be(true)
 app:click('role:button "Open image panel"')
 expect(app:wait('~"count=2"')).to_be(true)
 expect(app:has('#nekos-native-image >> role:button')).to_be(false)
 app:click('role:button "Next"')
 expect(app:has('~"index=2"')).to_be(true)
 app:click('role:button "Next"')
 expect(app:has('~"index=1"')).to_be(true)
 app:click('role:button "Previous"')
 expect(app:has('~"index=2"')).to_be(true)
end)

test("slideshow advances in order, pauses while hidden, and persists controls",function()
 local app=mount()
 app:click('role:button "Open image panel"')
 expect(app:wait('~"count=2"')).to_be(true)
 app:command("fast")
 app:command("loaded")
 app:click('role:switch "Slideshow"')
 app:frames(90)
 expect(app:has('~"index=2"')).to_be(true)
 app:command("loaded")
 app:command("hide")
 app:frames(150)
 expect(app:has('~"index=2"')).to_be(true)
 local reopened=mount()
 expect(reopened:has('~"playing=true; seconds=1"')).to_be(true)
 reopened:command("defaults")
 expect(reopened:has('~"playing=false; seconds=20"')).to_be(true)
end)

test("NSFW master gate clears the native panel immediately",function()
 local app=mount()
 app:click('role:button "Open image panel"')
 expect(app:wait('~"count=2"')).to_be(true)
 app:command("nsfw")
 expect(app:wait('"NSFW preview protected. Reveal it here."')).to_be(true)
 expect(app:count('#nekos-native-image >> role:img')).to_be(0)
 app:click('role:button "Reveal image"')
 expect(app:wait('"NSFW preview protected. Reveal it here."',{gone=true})).to_be(true)
 app:command("nsfw-off")
 expect(app:wait('~"count=0"')).to_be(true)
 expect(app:has('role:button "Reveal image"')).to_be(false)
end)

test("rate limit blocks manual refresh during cooldown",function()
 local app=mount()
 app:click('role:button "Open image panel"')
 expect(app:wait('~"count=2"')).to_be(true)
 app:command("limited")
 expect(app:wait('~"Nekos API rate limit"')).to_be(true)
 expect(app:has('~"requests=2"')).to_be(true)
 app:frames(120)
 expect(app:has('~"requests=2"')).to_be(true)
end)
